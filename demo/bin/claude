#!/usr/bin/env python3
"""A stand-in for Claude Code, for the demo to point the overlay at.

The real thing is not run: a demo has to come out the same every time, and a coding agent does
not. What matters for wayhint is only that the terminal's foreground process is called
``claude``, which is what picks ``claude-code.yaml`` (README「どのシートが選ばれるか」). Two
things make that work and both are easy to break:

* the **file name** is the whole trick -- ``/proc`` (and Herdr) report ``argv[0]``, and for a
  ``#!/usr/bin/env python3`` script that is this file's own name;
* ``prctl(PR_SET_NAME)`` makes ``comm`` say it too, which is what Herdr reports as ``name``.
  Without it the overlay's context line reads ``python3``.

It must not start a child of its own: wayhint takes the deepest process in the terminal's
foreground group, and a ``sleep`` here would become the answer instead of this.

The screen is a plain waiting prompt. No conversation, no logos, no copied wording -- the
storyboard asks for "just started, waiting for input", and the banner says it is a stub.
"""

import ctypes
import os
import sys

NAME = "claude"
TITLE = f"{NAME}  ·  demo stub"
LINES = [
    "Working in ~/demo",
    "Type a request, or / for commands.",
]
DIM = "\033[38;5;110m"
TEXT = "\033[38;5;252m"
PROMPT = "\033[38;5;150m"
OFF = "\033[0m"


def rename() -> None:
    """Make ``/proc/self/comm`` say this file's name, the way an installed binary would."""
    try:
        ctypes.CDLL(None, use_errno=True).prctl(15, os.path.basename(__file__).encode()[:15])
    except OSError:  # PR_SET_NAME is Linux-only; the demo only runs there
        pass


def main() -> int:
    rename()
    body = "\n".join(f"  {TEXT}{line}{OFF}" for line in LINES)
    sys.stdout.write(f"  {DIM}{TITLE}{OFF}\n\n{body}\n\n{PROMPT}>{OFF} ")
    sys.stdout.flush()
    try:
        sys.stdin.read()  # wait, without spawning anything
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
