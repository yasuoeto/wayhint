#!/usr/bin/env python3
"""What Herdr starts in every pane, in place of a shell.

A demo types into the terminal on purpose -- that is the whole point of the "it does not take
the keyboard" scene -- and a recording is driven by a file. Put those together with a shell in
the pane and the scenario would be able to run anything at all. So there is no shell in the
session (DECISIONS 0032): Herdr's ``default_shell`` is this, and this only ever starts one of
the demo's own stubs.

It prints one line, reads lines, and if a line is the name of one of the stubs in
:data:`STARTABLE` it replaces itself with that one. ``herdr pane run <pane> claude`` is exactly
such a line. Anything else is read and dropped, so a ``type:`` step lands in a program that
cannot act on it.

The names are written out here rather than read off the directory: a listing answers "what is
next to me", which is a different question from "what may a pane start", and it would quietly
grow the answer every time somebody adds a file to ``demo/bin``.
"""

import os
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
BANNER = "  (demo pane)"

STARTABLE = ("claude", "codex", "vi")
"""The stubs a pane may be told to run. Not the ``foot-*`` wrappers: those start terminals."""


def target(name: str, here: Path = HERE) -> Path | None:
    """The stub to exec for a typed line, or ``None`` when there is nothing to start.

    ``None`` rather than an error: everything a pane cannot act on is read and dropped, and a
    name that is not a stub is just more of that. The file itself is checked as well as the
    name -- a symlink would run whatever it points at under a stub's name.
    """
    if name not in STARTABLE:
        return None
    path = here / name
    if path.is_symlink() or not path.is_file() or not os.access(path, os.X_OK):
        return None
    if path.resolve().parent != here.resolve():
        return None
    return path


def main() -> int:
    sys.stdout.write(BANNER + "\n")
    sys.stdout.flush()
    for line in sys.stdin:
        stub = target(line.strip())
        if stub is not None:
            os.execv(str(stub), [stub.name])  # noqa: S606 - a name from STARTABLE
    return 0


if __name__ == "__main__":
    sys.exit(main())
