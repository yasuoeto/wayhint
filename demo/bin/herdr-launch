#!/usr/bin/env python3
"""A terminal showing how to start Herdr so that wayhint can look inside it, for the scene that
says this is the one step of setup the herdr showcase needs.

What it shows is not written here: it is the ``sh`` block under ``### Herdr`` in
``docs/TERMINALS.md`` (``docs/TERMINALS.ja.md`` in a Japanese recording) -- one launch line each
for kitty, Ghostty and foot -- read when the stub starts. The document is where a person looks
this up, so the video and the document cannot say two different things. The block not being
found is a failure, and the rename below is skipped.

``comm`` is renamed only *after* the text is written, as in ``wayhint-shown``: the scenario
waits for this name, so a step that sees it knows the text is already on screen.
"""

import ctypes
import os
import sys
from pathlib import Path

DOCS = Path(__file__).resolve().parent.parent.parent / "docs"
DOC = {"en": DOCS / "TERMINALS.md", "ja": DOCS / "TERMINALS.ja.md"}
"""The document per language; both keep the heading and the block below verbatim."""
HEADING = "### Herdr"
NOTE = {
    "en": "# Open Herdr in a terminal whose app_id contains herdr (docs/TERMINALS.md)",
    "ja": "# Herdr は、app_id に herdr を含めた端末で開く(docs/TERMINALS.ja.md)",
}

GREY = "\033[38;5;103m"
TEXT = "\033[38;5;252m"
PROMPT = "\033[38;5;150m"
OFF = "\033[0m"


def rename() -> None:
    try:
        ctypes.CDLL(None, use_errno=True).prctl(15, os.path.basename(__file__).encode()[:15])
    except OSError:
        pass


def demo_language() -> str:
    """The language this recording is in: the ``language:`` line of the session's config.yaml.

    The recorder writes it into the session's copy of the fixtures (``$WAYHINT_DEMO_CONFIG``);
    run by hand outside a recording, this is English.
    """
    root = os.environ.get("WAYHINT_DEMO_CONFIG")
    if root:
        try:
            for line in (Path(root) / "config.yaml").read_text().splitlines():
                if line.strip().startswith("language:"):
                    return line.split(":", 1)[1].strip() or "en"
        except OSError:
            pass
    return "en"


def launch_lines(text: str) -> list[str]:
    """The first ``sh`` block after the Herdr heading, or ``[]``."""
    lines = text.splitlines()
    try:
        start = lines.index(HEADING)
    except ValueError:
        return []
    block: list[str] | None = None
    for line in lines[start + 1 :]:
        if block is None and line.startswith("#"):
            break  # the next section: the Herdr one has no block
        if block is None:
            if line.strip() == "```sh":
                block = []
        elif line.strip() == "```":
            return block
        else:
            block.append(line)
    return []


def main() -> int:
    language = demo_language()
    doc = DOC.get(language, DOC["en"])
    lines = launch_lines(doc.read_text())
    if not lines:
        sys.stderr.write(f"herdr-launch: no sh block under {HEADING!r} in {doc}\n")
        sys.stdin.read()
        return 1
    out = [f"{GREY}{NOTE.get(language, NOTE['en'])}{OFF}"]
    out += [f"{PROMPT}${OFF} {TEXT}{line}{OFF}" for line in lines]
    sys.stdout.write("\n".join(out) + "\n")
    sys.stdout.flush()
    rename()
    try:
        sys.stdin.read()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
