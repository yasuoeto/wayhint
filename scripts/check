#!/bin/sh
# The only validation entry point for this repository (python profile).
set -eu
CDPATH=''
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
cd "$root"
status=0

run() {
    printf 'check: %s\n' "$*"
    "$@" || status=1
}
skip() {
    printf 'check: %s is not on PATH; skipped\n' "$1" >&2
}

if command -v tool-init >/dev/null 2>&1; then
    run tool-init lint .agents/skills
else
    skip tool-init
fi

if command -v ruff >/dev/null 2>&1; then
    run ruff check .
    run ruff format --check .
else
    skip ruff
fi

run python3 -m compileall -q src tests
run python3 -m unittest discover -s tests -t .

exit "$status"
