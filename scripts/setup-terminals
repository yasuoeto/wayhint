#!/usr/bin/env python3
"""Point every way of launching a terminal at a wrapper that puts its pid in the app_id.

``docs/TERMINALS.md`` is the prose; this applies it. Two kinds of file are involved and they are
treated differently:

* **Files wayhint owns** -- the wrappers in ``~/.local/bin`` and the ``.desktop`` overrides in
  ``~/.local/share/applications`` -- are written and kept up to date. They are generated, carry a
  marker saying so, and anything without that marker is left alone.
* **Files the user maintains** -- a bar's configuration, a compositor's menu -- are *reported*,
  never edited. They are hand-written and carry comments that a mechanical rewrite would lose.

Usage::

    scripts/setup-terminals [--apply] [TERMINAL ...]

**Nothing is written without ``--apply``.** The default is a dry run that says what it would do,
whether or not a TERMINAL was named, because the files live in the user's home and the first run
should be readable rather than surprising. With no TERMINAL named it covers every terminal it
knows about and finds installed. The exit status is 1 while anything is still to do, so the dry
run doubles as a health check.
"""

from __future__ import annotations

import argparse
import datetime as _dt
import os
import re
import shutil
import stat
import sys
from dataclasses import dataclass
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))

from wayhint.context.proc import TERMINAL_APP_IDS  # noqa: E402

MARKER = "generated by wayhint scripts/setup-terminals"


@dataclass(frozen=True)
class Terminal:
    """How one terminal is told to put ``<app-id>.p<pid>`` on the windows it opens."""

    name: str  # the executable, and the name to pass on the command line
    app_id: str  # the base app_id; the pid suffix is appended to this
    flag: str  # the option that sets the Wayland app_id
    extra: tuple[str, ...]  # options the wrapper must add for the convention to hold
    desktop: str  # the system .desktop file to override
    drop: tuple[str, ...]  # options to remove from a copied Exec line; the wrapper sets them


TERMINALS = (
    Terminal("foot", "foot", "--app-id", (), "foot.desktop", ("--app-id", "-a")),
    # ``single_instance`` would put every window in one process, and then one pid cannot stand
    # for one window. The wrapper turns it off rather than asking the user to edit kitty.conf.
    Terminal(
        "kitty",
        "kitty",
        "--class",
        ("-o", "single_instance=no"),
        "kitty.desktop",
        ("--class", "--app-id"),
    ),
    Terminal(
        "ghostty",
        "com.mitchellh.ghostty",
        "--class",
        ("--gtk-single-instance=false",),
        "com.mitchellh.ghostty.desktop",
        ("--class", "--gtk-single-instance"),
    ),
    # One process per window unless started through ``alacritty msg create-window`` or
    # ``--daemon``, which the wrapper never does. The app_id is lower-case on purpose: the default
    # ``Alacritty`` would not equal ``comm`` (``alacritty``), and the pid check compares the two.
    Terminal("alacritty", "alacritty", "--class", (), "Alacritty.desktop", ("--class",)),
)

UNSUPPORTED = {
    "wezterm": "窓ごとに app_id を変えられないため、この規約に乗らない",
    "xfce4-terminal": "対象外(Xwayland。app_id を窓ごとに変えられない)",
}


@dataclass(frozen=True)
class Launcher:
    """A file that may start a terminal, and how a command is written in it."""

    path: str  # relative to $XDG_CONFIG_HOME
    kind: str  # json | xml | ini | shell -- which extractor finds the commands in a line


LAUNCHERS = (
    Launcher("waybar/config", "json"),
    Launcher("waybar/config.json", "json"),
    Launcher("waybar/config.jsonc", "json"),
    Launcher("labwc/menu.xml", "xml"),
    Launcher("labwc/rc.xml", "xml"),
    Launcher("labwc/autostart", "shell"),
    Launcher("fuzzel/fuzzel.ini", "ini"),
    Launcher("wayfire.ini", "ini"),
)
"""Where a terminal is usually launched from. Only these are looked at."""

JSON_COMMAND_KEY = re.compile(r'"(on-click[\w-]*|on-scroll[\w-]*|exec|command)"\s*:\s*"([^"]*)"')
XML_COMMAND = re.compile(r'command="([^"]*)"')
INI_ASSIGNMENT = re.compile(r"^\s*[\w.-]+\s*=\s*(.+?)\s*$")
COMMENT = re.compile(r"^\s*(#|//|<!--|;|--)")


def home() -> Path:
    return Path(os.environ.get("HOME") or Path.home())


def data_home() -> Path:
    return Path(os.environ.get("XDG_DATA_HOME") or home() / ".local/share")


def config_home() -> Path:
    return Path(os.environ.get("XDG_CONFIG_HOME") or home() / ".config")


def system_data_dirs() -> list[Path]:
    raw = os.environ.get("XDG_DATA_DIRS") or "/usr/local/share:/usr/share"
    return [Path(p) for p in raw.split(":") if p]


def wrapper_path(term: Terminal) -> Path:
    return home() / ".local/bin" / f"{term.name}-wayhint"


def wrapper_body(term: Terminal, binary: str) -> str:
    """The wrapper. ``exec`` is what makes ``$$`` the terminal's own pid."""
    args = " ".join([binary, *term.extra, term.flag, f'"{term.app_id}.p$$"', '"$@"'])
    return f"#!/bin/sh\n# {MARKER} -- docs/TERMINALS.md\nexec {args}\n"


def split_exec(value: str) -> list[str]:
    """Desktop-entry ``Exec`` into arguments. Quoting here is simple enough not to need shlex."""
    return value.split()


def rewrite_exec(value: str, term: Terminal, wrapper: Path) -> str | None:
    """``Exec=`` pointing at the terminal → pointing at the wrapper, or ``None`` if it does not.

    Arguments the wrapper sets itself are dropped; everything else (``%F`` and friends, ``-e``)
    is kept, because the launcher relies on it.
    """
    parts = split_exec(value)
    if not parts or parts[0].rsplit("/", 1)[-1] != term.name:
        return None
    kept: list[str] = []
    skip = False
    for arg in parts[1:]:
        if skip:
            skip = False
            continue
        if arg in term.drop:  # "--class foo": the value is the next argument
            skip = True
            continue
        if any(arg.startswith(f"{d}=") for d in term.drop):
            continue
        kept.append(arg)
    return " ".join([str(wrapper), *kept])


def desktop_override(source: str, term: Terminal, wrapper: Path) -> str | None:
    """The system entry with every ``Exec`` that runs the terminal pointed at the wrapper."""
    out = [f"# {MARKER} -- docs/TERMINALS.md"]
    changed = False
    for line in source.splitlines():
        key, sep, value = line.partition("=")
        if sep and key.strip() == "Exec":
            replaced = rewrite_exec(value.strip(), term, wrapper)
            if replaced is not None:
                out.append(f"Exec={replaced}")
                changed = True
                continue
        out.append(line)
    return "\n".join(out) + "\n" if changed else None


def find_system_desktop(term: Terminal) -> Path | None:
    for base in system_data_dirs():
        candidate = base / "applications" / term.desktop
        if candidate.is_file():
            return candidate
    return None


def owned_by_us(path: Path) -> bool:
    try:
        return MARKER in path.read_text()
    except OSError:
        return False


def commands_in(line: str, kind: str) -> list[tuple[str, int, int]]:
    """The command strings a line runs, each with where it sits in the line.

    Matching the terminal's name anywhere in the line finds prose, tooltips and comments far more
    often than launchers, so only the value of something that is actually executed counts. The
    span is what lets an edit touch exactly that value and nothing else on the line.
    """
    if COMMENT.match(line):
        return []
    if kind == "json":
        return [(m.group(2), *m.span(2)) for m in JSON_COMMAND_KEY.finditer(line)]
    if kind == "xml":
        return [(m.group(1), *m.span(1)) for m in XML_COMMAND.finditer(line)]
    if kind == "ini":
        found = INI_ASSIGNMENT.match(line)
        return [(found.group(1), *found.span(1))] if found else []
    stripped = line.strip()  # shell: the line is the command
    start = len(line) - len(line.lstrip())
    return [(stripped, start, start + len(stripped))] if stripped else []


def launches(command: str, term: Terminal) -> bool:
    """Does this command start the terminal, in a way that still needs the wrapper?

    A command that already sets the app_id itself is left alone: it was written that way on
    purpose (a Herdr window opened as ``foot --app-id=foot-herdr`` is this repository's example).
    """
    parts = command.split()
    if not parts or parts[0].rsplit("/", 1)[-1] != term.name:
        return False
    return not any(a.startswith(("--app-id", "--class", "-a=")) or a == "-a" for a in parts[1:])


def point_at(line: str, kind: str, term: Terminal, wrapper: Path) -> str | None:
    """The line with every command that starts the terminal pointed at the wrapper.

    Only the command's first word is replaced, in place. The file is never parsed and never
    written back out from a parse tree, so comments, key order and whitespace survive untouched --
    which is what made rewriting these files look unsafe in the first place (DECISIONS 0029).
    """
    out = line
    for command, start, end in reversed(commands_in(line, kind)):
        if not launches(command, term):
            continue
        parts = command.split()
        replaced = " ".join([str(wrapper), *parts[1:]])
        out = out[:start] + replaced + out[end:]
    return out if out != line else None


def launcher_hits(term: Terminal, wrapper: Path) -> list[tuple[Path, int, str, str]]:
    """Lines that still launch the terminal directly, with what they should say instead."""
    hits = []
    for launcher in LAUNCHERS:
        path = config_home() / launcher.path
        try:
            lines = path.read_text(errors="replace").splitlines()
        except OSError:
            continue
        for number, line in enumerate(lines, start=1):
            if "-wayhint" in line:
                continue
            replaced = point_at(line, launcher.kind, term, wrapper)
            if replaced is not None:
                hits.append((path, number, line, replaced))
    return hits


def edit_lines(path: Path, replacements: dict[int, str], stamp: str) -> Path:
    """Apply line replacements in place, after copying the file aside. Returns the copy.

    The backup is what makes this safe to run on a configuration somebody has been maintaining by
    hand: one copy per file per run, named so that several runs do not overwrite each other.
    """
    backup = path.with_name(f"{path.name}.wayhint-backup-{stamp}")
    original = path.read_text()
    if not backup.exists():
        backup.write_text(original)
    ends_with_newline = original.endswith("\n")
    lines = original.splitlines()
    for number, replacement in replacements.items():
        lines[number - 1] = replacement
    path.write_text("\n".join(lines) + ("\n" if ends_with_newline else ""))
    return backup


def write(path: Path, content: str, executable: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)
    if executable:
        path.chmod(path.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)


@dataclass
class Plan:
    """What one terminal still needs: what to say, what to write, what to edit."""

    notes: list[str]
    writes: list[tuple[Path, str, bool]]  # path, content, executable
    edits: dict[Path, dict[int, str]]  # path -> {line number: replacement}

    def outstanding(self) -> int:
        return len(self.writes) + sum(len(lines) for lines in self.edits.values())


def plan_terminal(term: Terminal, binary: str) -> Plan:
    """What is outstanding for one terminal."""
    notes: list[str] = []
    writes: list[tuple[Path, str, bool]] = []
    edits: dict[Path, dict[int, str]] = {}

    target = wrapper_path(term)
    body = wrapper_body(term, binary)
    if target.exists() and not owned_by_us(target):
        notes.append(f"  wrapper   {target}: 手で書かれたものがあるので触りません")
    elif not target.exists():
        notes.append(f"  wrapper   {target}: 作成します")
        writes.append((target, body, True))
    elif target.read_text() != body:
        notes.append(f"  wrapper   {target}: 内容が古いので更新します")
        writes.append((target, body, True))
    else:
        notes.append(f"  wrapper   {target}: 最新です")

    system = find_system_desktop(term)
    override = data_home() / "applications" / term.desktop
    if system is None:
        notes.append(f"  .desktop  {term.desktop}: システム側に見つからないので飛ばします")
    else:
        content = desktop_override(system.read_text(), term, target)
        if content is None:
            notes.append(f"  .desktop  {system}: Exec が {term.name} を呼んでいないので飛ばします")
        elif override.exists() and not owned_by_us(override):
            notes.append(f"  .desktop  {override}: 手で書かれたものがあるので触りません")
        elif not override.exists():
            notes.append(f"  .desktop  {override}: 作成します")
            writes.append((override, content, False))
        elif override.read_text() != content:
            notes.append(f"  .desktop  {override}: 内容が古いので更新します")
            writes.append((override, content, False))
        else:
            notes.append(f"  .desktop  {override}: 最新です")

    for path, number, line, replacement in launcher_hits(term, target):
        notes.append(f"  launcher  {path}:{number}")
        notes.append(f"              - {line.strip()}")
        notes.append(f"              + {replacement.strip()}")
        edits.setdefault(path, {})[number] = replacement
    return Plan(notes, writes, edits)


def chosen(names: list[str]) -> tuple[list[Terminal], list[str], int]:
    known = {t.name: t for t in TERMINALS}
    if not names:
        found = [t for t in TERMINALS if shutil.which(t.name)]
        missing = [
            f"{t.name}: 入っていないので飛ばします" for t in TERMINALS if not shutil.which(t.name)
        ]
        return found, missing, 0
    picked, notes, bad = [], [], 0
    for name in names:
        if name in UNSUPPORTED:
            notes.append(f"{name}: {UNSUPPORTED[name]}")
            bad = 1
        elif name not in known:
            notes.append(f"{name}: 知らない端末です。対象は {', '.join(known)}")
            bad = 1
        elif not shutil.which(name):
            notes.append(f"{name}: 入っていません")
            bad = 1
        else:
            picked.append(known[name])
    return picked, notes, bad


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="setup-terminals", description="端末の窓に app_id の pid 接尾辞を付ける設定を行う"
    )
    parser.add_argument("--apply", action="store_true", help="実際に書き込む(既定は dry run)")
    parser.add_argument(
        "--check", action="store_true", help="既定と同じ dry run。意図をはっきりさせたいときに"
    )
    parser.add_argument(
        "terminal", nargs="*", help=f"既定は全部。対象: {', '.join(t.name for t in TERMINALS)}"
    )
    args = parser.parse_args(argv)
    if args.apply and args.check:
        parser.error("--apply と --check は同時に指定できません")
    dry_run = not args.apply

    drift = {t.app_id for t in TERMINALS} - set(TERMINAL_APP_IDS)
    if drift:
        print(
            f"setup-terminals: {sorted(drift)} は wayhint 側の TERMINAL_APP_IDS にありません",
            file=sys.stderr,
        )
        return 2

    terminals, notes, status = chosen(args.terminal)
    for note in notes:
        print(note)

    stamp = _dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    generated = edited = 0
    backups: list[Path] = []
    edits: dict[Path, dict[int, str]] = {}
    for term in terminals:
        binary = shutil.which(term.name) or f"/usr/bin/{term.name}"
        plan = plan_terminal(term, binary)
        print(f"{term.name} ({term.app_id}.p$$)")
        for message in plan.notes:
            print(message)
        if not dry_run:
            for path, content, executable in plan.writes:
                write(path, content, executable)
        generated += len(plan.writes)
        # One file can host several terminals, so the edits are merged before anything is written.
        for path, lines in plan.edits.items():
            edits.setdefault(path, {}).update(lines)
    edited = sum(len(lines) for lines in edits.values())
    if not dry_run:
        backups = [edit_lines(path, lines, stamp) for path, lines in edits.items()]

    print()
    if not terminals:
        print("対象の端末がありません")
        return status
    print(f"見た launcher: {', '.join(launcher.path for launcher in LAUNCHERS)}")
    if dry_run:
        if generated or edited:
            print(f"残: 生成 {generated} 件、launcher {edited} 行")
            print("書き込むには --apply を付けてください(ここまでは何も書いていません)")
            return 1
    else:
        print(f"生成 {generated} 件、launcher {edited} 行を書き換えました")
        for backup in backups:
            print(f"  バックアップ {backup}")
        if edited:
            print("反映は waybar 再起動 / labwc --reconfigure など(docs/TERMINALS.md)")
    print("すべて設定済みです")
    return status


if __name__ == "__main__":
    raise SystemExit(main())
